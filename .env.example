# Sathya Assist - Environment Configuration
# Copy to .env and populate credentials for production LLM mode.
# Leave LLM keys blank to run in deterministic offline extractive mode.

# Azure OpenAI (Primary)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01

# OpenAI Fallback (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# API & Security
ALLOWED_ORIGINS=*
RATE_LIMIT_RPM=30
PORT=8000
